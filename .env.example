# ===========================================
# Bender - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# -------------------------------------------
# Required: Slack
# -------------------------------------------
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# -------------------------------------------
# Required: Claude Code authentication
# Provide at least one of the following:
# -------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-api-key
# CLAUDE_CODE_OAUTH_TOKEN=your-oauth-token

# -------------------------------------------
# Optional: Bender settings
# -------------------------------------------
BENDER_WORKSPACE=/workspace
BENDER_ALLOWED_CHANNELS=C0123456789
BENDER_TIMEOUT_SECONDS=900
# Leave unset to use Claude Code's default. Use bypassPermissions only inside
# a dedicated, OS-isolated analysis workspace with no sensitive host mounts.
# BENDER_PERMISSION_MODE=bypassPermissions
BENDER_API_HOST=127.0.0.1
BENDER_API_PORT=8080
BENDER_API_KEY=your-secret-api-key
LOG_LEVEL=info
